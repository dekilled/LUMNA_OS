# A sessão ANTIGA do LUMNA (Hyprland + lumna-shell, em Tauri), só como sessão de emergência escolhível no
# login enquanto o Orbit não provar que sobe numa tela de verdade. Sai do ISO (e do repositório) quando o
# Eric validar o Orbit; o estado de antes fica na tag ui-antiga-hyprland.
pkgname=lumna-classico
pkgver=0.0.1
pkgrel=1
pkgdesc="Sessão antiga do LUMNA (Hyprland + lumna-shell), só de emergência"
arch=(any)
url="https://github.com/dekilled/LUMNA_OS"
license=(GPL-3.0-or-later)
depends=(
  lumna-session lumna-shell hyprland xdg-desktop-portal-hyprland swaybg hyprlock hypridle
  # o que o shell antigo chamava e a sessão nova não pede
  cups cups-filters
)

_root="$(realpath "$startdir/../..")"

package() {
  cd "$_root/session"
  install -Dm755 lumna-session "$pkgdir/usr/bin/lumna-classico-session"
  install -Dm755 lumna-shell-run "$pkgdir/usr/lib/lumna/lumna-shell-run"
  install -Dm644 hyprland.lua "$pkgdir/usr/share/lumna/hyprland.lua"
  install -Dm644 lumna-classico.desktop "$pkgdir/usr/share/wayland-sessions/lumna.desktop"
  install -Dm644 lumna-settings.desktop "$pkgdir/usr/share/applications/lumna-settings.desktop"
  install -Dm644 icons/settings.svg "$pkgdir/usr/share/lumna/icons/settings.svg"
  install -Dm644 lumna-store.desktop "$pkgdir/usr/share/applications/lumna-store.desktop"
  install -Dm644 icons/store.svg "$pkgdir/usr/share/lumna/icons/store.svg"
  install -Dm644 lumna-files.desktop "$pkgdir/usr/share/applications/lumna-files.desktop"
  install -Dm644 icons/files.svg "$pkgdir/usr/share/lumna/icons/files.svg"
}
