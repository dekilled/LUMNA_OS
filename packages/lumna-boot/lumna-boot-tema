#!/bin/sh
# lumna-boot-tema: o visual de boot do LUMNA (tema do GRUB e animação do Plymouth) no sistema em uso.
#
#   lumna-boot-tema aplicar      põe o tema no GRUB (o fundo e os itens, o menu na resolução 1920x1080 se a tela deixar, "splash" no kernel) e a
#                                animação de boot no initramfs (o gancho plymouth do mkinitcpio), e regera o menu e o initramfs
#   lumna-boot-tema grub         só a parte do GRUB
#   lumna-boot-tema plymouth     só a parte do Plymouth (e o initramfs)
#   lumna-boot-tema regerar      regera o menu do GRUB e refaz os ícones das entradas (o gancho do pacman chama isto depois de um kernel novo)
#   lumna-boot-tema desfazer     tira o tema do GRUB e a animação de boot
#   lumna-boot-tema diagnostico  mostra tudo o que importa quando o tema ou a animação não aparecem (cole a saída para pedir ajuda; não precisa de root)
#
# Não mexe na detecção de outros sistemas nem nas entradas que você já tem: só o tema, a resolução e o "splash". Precisa de root.
# Opções: --sem-initramfs e --sem-menu (para o instalador, que refaz os dois depois); LUMNA_RAIZ=/pasta roda sobre outra raiz (testes).
set -e
RAIZ=${LUMNA_RAIZ:-}
TEMA_GRUB_ORIGEM=${LUMNA_TEMA_GRUB:-/usr/share/lumna/grub/lumna}
ACAO=${1:-}
[ $# -gt 0 ] && shift
SEM_INITRAMFS=0; SEM_MENU=0
for a in "$@"; do
	case "$a" in
	--sem-initramfs) SEM_INITRAMFS=1 ;;
	--sem-menu) SEM_MENU=1 ;;
	*) echo "lumna-boot-tema: opção desconhecida: $a" >&2; exit 2 ;;
	esac
done
[ "$ACAO" != diagnostico ] && [ -z "$RAIZ" ] && [ "$(id -u)" != 0 ] && { echo "lumna-boot-tema: precisa de root (sudo lumna-boot-tema $ACAO)" >&2; exit 1; }

DEFAULT="$RAIZ/etc/default/grub"
MKINIT="$RAIZ/etc/mkinitcpio.conf"
GRUB_DIR="$RAIZ/boot/grub"
TEMA_GRUB="$GRUB_DIR/themes/lumna"

dizer() { echo "lumna-boot-tema: $*"; }

# põe CHAVE=VALOR no /etc/default/grub (troca a linha, ou acrescenta no fim)
grub_definir() {
	chave=$1; valor=$2
	if grep -q "^$chave=" "$DEFAULT"; then
		sed -i "s|^$chave=.*|$chave=$valor|" "$DEFAULT"
	else
		printf '%s=%s\n' "$chave" "$valor" >> "$DEFAULT"
	fi
}
grub_tirar() { sed -i "/^$1=/d" "$DEFAULT"; }

# acrescenta (ou tira) uma palavra de GRUB_CMDLINE_LINUX_DEFAULT
cmdline() { # cmdline add|del palavra
	linha=$(grep '^GRUB_CMDLINE_LINUX_DEFAULT=' "$DEFAULT" || true)
	[ -z "$linha" ] && { [ "$1" = add ] && printf 'GRUB_CMDLINE_LINUX_DEFAULT="%s"\n' "$2" >> "$DEFAULT"; return 0; }
	atual=$(printf '%s' "$linha" | sed 's/^GRUB_CMDLINE_LINUX_DEFAULT=//; s/^"//; s/"$//')
	novo=$(printf '%s\n' $atual | grep -vx -- "$2" | tr '\n' ' ' | sed 's/ $//')
	[ "$1" = add ] && novo="$novo $2"
	novo=$(printf '%s' "$novo" | sed 's/^ //')
	sed -i "s|^GRUB_CMDLINE_LINUX_DEFAULT=.*|GRUB_CMDLINE_LINUX_DEFAULT=\"$novo\"|" "$DEFAULT"
}

# os ícones: o GRUB só dá ícone pela classe da entrada, e a de opções avançadas e a do firmware não vêm com uma
classes_no_menu() {
	cfg="$GRUB_DIR/grub.cfg"
	[ -f "$cfg" ] || return 0
	sed -i -e "s|^\([[:space:]]*submenu '[^']*'\)\([[:space:]]\)|\1 --class advanced\2|" \
		-e "s|^\([[:space:]]*menuentry 'UEFI Firmware Settings'\)\([[:space:]]\)|\1 --class firmware\2|" \
		-e "s|^\([[:space:]]*menuentry 'Configurações do firmware UEFI'\)\([[:space:]]\)|\1 --class firmware\2|" "$cfg"
	# uma entrada que já tinha a classe não a repete
	sed -i -e 's/ --class advanced --class advanced/ --class advanced/' -e 's/ --class firmware --class firmware/ --class firmware/' "$cfg"
}

gerar_menu() {
	[ "$SEM_MENU" = 1 ] && return 0
	if [ -n "$RAIZ" ]; then
		grub-mkconfig -o "$GRUB_DIR/grub.cfg" >/dev/null 2>&1
	else
		# em português (os nomes das entradas), se o sistema tem o idioma
		LANG=${LUMNA_LANG_GRUB:-pt_BR.UTF-8} grub-mkconfig -o "$GRUB_DIR/grub.cfg" >/dev/null 2>&1 || grub-mkconfig -o "$GRUB_DIR/grub.cfg" >/dev/null 2>&1
	fi
	classes_no_menu
}

parte_grub() {
	[ -f "$DEFAULT" ] || { dizer "não achei $DEFAULT: este sistema não usa o GRUB?" >&2; return 1; }
	[ -d "$TEMA_GRUB_ORIGEM" ] || { dizer "faltam os arquivos do tema ($TEMA_GRUB_ORIGEM): o pacote lumna-boot está instalado?" >&2; return 1; }
	mkdir -p "$GRUB_DIR/themes"
	rm -rf "$TEMA_GRUB"
	cp -r "$TEMA_GRUB_ORIGEM" "$TEMA_GRUB"
	grub_definir GRUB_THEME '"/boot/grub/themes/lumna/theme.txt"'
	grub_definir GRUB_GFXMODE '"1920x1080,auto"'
	grub_definir GRUB_GFXPAYLOAD_LINUX keep
	grub_definir GRUB_TERMINAL_OUTPUT gfxterm
	cmdline add splash
	gerar_menu
	dizer "tema do GRUB aplicado"
}

# o initramfs refeito tem mesmo o plymouth? (sem ele a animação só aparece no desligamento: é quem liga o Plymouth cedo na inicialização)
conferir_initramfs() {
	command -v lsinitcpio >/dev/null || return 0
	for img in "$RAIZ"/boot/initramfs-linux*.img; do
		[ -e "$img" ] || continue
		case "$img" in *fallback*) continue ;; esac
		if ! lsinitcpio "$img" 2>/dev/null | grep -q 'plymouthd'; then
			dizer "aviso: $img NÃO tem o plymouth. Confira o gancho em $MKINIT (HOOKS) e rode 'sudo mkinitcpio -P' para ver o erro" >&2
		elif ! lsinitcpio "$img" 2>/dev/null | grep -q 'themes/lumna'; then
			dizer "aviso: $img tem o plymouth mas não o tema do LUMNA (Theme=lumna em /etc/plymouth/plymouthd.conf)" >&2
		fi
	done
}

# drivers de vídeo que o initramfs deve carregar ANTES do Plymouth: sem isso o Plymouth abre no framebuffer genérico da UEFI
# (simpledrm), o driver real entra um segundo depois e tira a tela dele (notebook do Eric, radeon: console de texto e só a tela final)
drivers_de_video() {
	if [ -n "$LUMNA_TESTE_DRIVERS" ]; then echo "$LUMNA_TESTE_DRIVERS"; return; fi
	for d in /sys/class/drm/card[0-9]*/device/driver; do
		[ -e "$d" ] && basename "$(readlink -f "$d")"
	done 2>/dev/null | sort -u
}

modulo_cedo() {
	[ -f "$MKINIT" ] || return 0
	for m in $(drivers_de_video); do
		case "$m" in i915|amdgpu|nouveau) ;; *) continue ;; esac
		grep -E '^MODULES=' "$MKINIT" | grep -Eq "[( ]$m[) ]" && continue
		if grep -Eq '^MODULES=\( *\)' "$MKINIT"; then
			sed -i -E "s/^MODULES=\( *\)/MODULES=($m)/" "$MKINIT"
		else
			sed -i -E "s/^(MODULES=\(.*[^ ]) *\)/\1 $m)/" "$MKINIT"
		fi
		grep -E '^MODULES=' "$MKINIT" | grep -q "$m" && dizer "driver de vídeo $m no initramfs (sobe antes do Plymouth)" || dizer "aviso: ponha $m em MODULES de $MKINIT à mão" >&2
	done
}

parte_plymouth() {
	# o gancho do mkinitcpio, logo depois do udev (ou do systemd): é ele que põe a animação no initramfs
	if [ -f "$MKINIT" ] && ! grep -E '^HOOKS=' "$MKINIT" | grep -q plymouth; then
		sed -i -E 's/^(HOOKS=\(.*\b(udev|systemd)\b)/\1 plymouth/' "$MKINIT"
		grep -E '^HOOKS=' "$MKINIT" | grep -q plymouth || dizer "aviso: não achei o udev nem o systemd nos HOOKS de $MKINIT; ponha o gancho plymouth à mão" >&2
	fi
	modulo_cedo
	mkdir -p "$RAIZ/etc/plymouth"
	printf '[Daemon]\nTheme=lumna\nShowDelay=0\n' > "$RAIZ/etc/plymouth/plymouthd.conf"
	if [ "$SEM_INITRAMFS" != 1 ]; then
		saida=$(mktemp)
		if ! mkinitcpio -P >"$saida" 2>&1; then
			dizer "aviso: o mkinitcpio falhou (a animação NÃO vai aparecer na inicialização, só no desligamento). O que ele disse:" >&2
			tail -n 12 "$saida" >&2
		fi
		rm -f "$saida"
		conferir_initramfs
	fi
	dizer "animação de boot aplicada"
}

desfazer() {
	if [ -f "$DEFAULT" ]; then
		grub_tirar GRUB_THEME
		grub_tirar GRUB_GFXMODE
		grub_tirar GRUB_GFXPAYLOAD_LINUX
		cmdline del splash
		[ -n "$(grep '^GRUB_TERMINAL_OUTPUT=gfxterm$' "$DEFAULT")" ] && grub_tirar GRUB_TERMINAL_OUTPUT
	fi
	rm -rf "$TEMA_GRUB"
	gerar_menu 2>/dev/null || true
	[ -f "$MKINIT" ] && sed -i -E '/^HOOKS=/ s/ plymouth\b//' "$MKINIT"
	rm -f "$RAIZ/etc/plymouth/plymouthd.conf"
	[ "$SEM_INITRAMFS" != 1 ] && { mkinitcpio -P >/dev/null 2>&1 || true; }
	dizer "o visual de boot do LUMNA foi tirado"
}

# tudo o que decide se o tema e a animação aparecem, numa saída só (o notebook do Eric: a animação não apareceu)
diagnostico() {
	set +e   # (um comando que falta ou um grep sem resultado não pode interromper o relatório)
	titulo() { printf '\n== %s\n' "$1"; }
	titulo "pacotes"; pacman -Q lumna-boot plymouth grub mkinitcpio linux 2>&1 | head -8
	titulo "kernel deste boot (/proc/cmdline: precisa de splash)"; cat /proc/cmdline 2>&1
	titulo "/etc/default/grub"
	grep -E '^(GRUB_THEME|GRUB_GFXMODE|GRUB_GFXPAYLOAD_LINUX|GRUB_TERMINAL_OUTPUT|GRUB_CMDLINE_LINUX_DEFAULT|GRUB_DISABLE_OS_PROBER|GRUB_TIMEOUT)=' "$DEFAULT" 2>&1
	titulo "o tema está em /boot/grub/themes/lumna?"; ls "$TEMA_GRUB" 2>&1 | head -4
	titulo "grub.cfg: o tema entrou no menu?"; grep -nE 'set theme=|theme\.txt|gfxmode|terminal_output|insmod (gfxterm|png)' "$GRUB_DIR/grub.cfg" 2>&1 | head -8
	titulo "mkinitcpio: HOOKS e MODULES (o plymouth entra depois do udev; o driver da placa tem de subir cedo)"; grep -E '^(HOOKS|MODULES)=' "$MKINIT" 2>&1
	titulo "o initramfs tem o plymouth e o tema?"
	for img in "$RAIZ"/boot/initramfs-linux*.img; do
		[ -e "$img" ] || continue
		printf '%s: ' "$img"
		if command -v lsinitcpio >/dev/null; then lsinitcpio "$img" 2>/dev/null | grep -cE 'plymouthd|themes/lumna|script\.so' ; else echo "(sem lsinitcpio)"; fi
	done
	titulo "/etc/plymouth/plymouthd.conf"; cat "$RAIZ/etc/plymouth/plymouthd.conf" 2>&1
	titulo "placa de vídeo e driver"
	lspci -k 2>/dev/null | grep -A3 -E 'VGA|3D|Display' | head -14
	lsmod 2>/dev/null | grep -E '^(i915|xe|amdgpu|radeon|nouveau|nvidia|nvidia_drm|simpledrm|virtio_gpu) ' | head
	titulo "o kernel e o framebuffer (simpledrm, efifb, drm)"; dmesg 2>/dev/null | grep -iE 'simpledrm|efifb|framebuffer|plymouth|fb0' | head -10
	titulo "o plymouth neste boot"
	journalctl -b --no-pager 2>/dev/null | grep -iE 'plymouth' | tail -12
	titulo "o complemento do greetd"; systemctl cat greetd 2>/dev/null | grep -B1 -A4 -i plymouth | head -10
	echo
	echo "(cole tudo isto na conversa; nada aqui tem senha nem dado pessoal)"
}

case "$ACAO" in
aplicar) parte_grub; parte_plymouth ;;
grub) parte_grub ;;
plymouth) parte_plymouth ;;
regerar) [ -d "$TEMA_GRUB" ] && gerar_menu || true ;; # (sem o tema aplicado, o gancho do pacman não mexe no menu de ninguém)
desfazer) desfazer ;;
diagnostico) diagnostico ;;
*) sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
