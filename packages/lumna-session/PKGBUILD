# Sessão LUMNA: configuração do Hyprland, entrada na tela de login e arte.
pkgname=lumna-session
pkgver=0.0.1
pkgrel=1
pkgdesc="Sessão Wayland do LUMNA OS (Hyprland + lumna-shell)"
arch=(any)
url="https://github.com/dekilled/LUMNA_OS"
license=(GPL-3.0-or-later)
depends=(
  lumna-shell hyprland xdg-desktop-portal-hyprland xdg-desktop-portal-gtk
  swaybg foot pipewire pipewire-pulse wireplumber polkit
  firefox mousepad gvfs
  mpv mpv-mpris ffmpeg playerctl wtype
  noto-fonts noto-fonts-emoji inter-font
  # Configurações: Wi-Fi, Bluetooth, impressoras (sem driver) e informações do hardware
  iwd bluez cups cups-filters ipp-usb avahi nss-mdns pciutils
  # Loja: Flatpak, AUR (git + base-devel para compilar) e checkupdates (pacman-contrib)
  flatpak git base-devel pacman-contrib curl
  # Instalador: particionar, Btrfs, copiar o sistema, boot
  gptfdisk btrfs-progs dosfstools rsync arch-install-scripts
  # Arquivos: lixeira e abrir com o programa padrão (gio), discos e pendrives (udisks)
  glib2 udisks2 xdg-utils
)

_root="$(realpath "$startdir/../..")"

package() {
  cd "$_root/session"
  install -Dm755 lumna-session "$pkgdir/usr/bin/lumna-session"
  install -Dm755 lumna-greeter "$pkgdir/usr/bin/lumna-greeter"
  install -Dm644 gpu-env "$pkgdir/usr/lib/lumna/gpu-env"
  install -Dm644 greeter.lua "$pkgdir/usr/share/lumna/greeter.lua"
  install -Dm755 lumna-install "$pkgdir/usr/lib/lumna/lumna-install"
  install -Dm644 os.lumna.install.policy "$pkgdir/usr/share/polkit-1/actions/os.lumna.install.policy"
  install -Dm644 icons/installer.svg "$pkgdir/usr/share/lumna/icons/installer.svg"
  install -Dm644 hyprland.lua "$pkgdir/usr/share/lumna/hyprland.lua"
  install -Dm644 wallpaper.png "$pkgdir/usr/share/lumna/wallpaper.png"
  install -Dm644 lumna.desktop "$pkgdir/usr/share/wayland-sessions/lumna.desktop"
  install -Dm644 lumna-settings.desktop "$pkgdir/usr/share/applications/lumna-settings.desktop"
  install -Dm644 icons/settings.svg "$pkgdir/usr/share/lumna/icons/settings.svg"
  install -Dm644 lumna-store.desktop "$pkgdir/usr/share/applications/lumna-store.desktop"
  install -Dm644 icons/store.svg "$pkgdir/usr/share/lumna/icons/store.svg"
  install -Dm644 lumna-files.desktop "$pkgdir/usr/share/applications/lumna-files.desktop"
  install -Dm644 icons/files.svg "$pkgdir/usr/share/lumna/icons/files.svg"
  install -Dm644 mimeapps.list "$pkgdir/usr/share/applications/mimeapps.list"
  install -Dm755 lumna-pkg "$pkgdir/usr/lib/lumna/lumna-pkg"
  install -Dm644 os.lumna.pkg.policy "$pkgdir/usr/share/polkit-1/actions/os.lumna.pkg.policy"
}
