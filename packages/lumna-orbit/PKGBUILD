# Orbit: o compositor do LUMNA OS (wlroots). O código é o orbit/ deste mesmo repositório.
pkgname=lumna-orbit
pkgver=0.0.1
pkgrel=1
pkgdesc="Orbit, o compositor Wayland do LUMNA OS (modos, várias telas, wlroots)"
arch=(x86_64 aarch64)
url="https://github.com/dekilled/LUMNA_OS"
license=(GPL-3.0-or-later)
# O Arch só tem o wlroots 0.20 (pacote wlroots0.20): o Orbit compila nele (PKGS abaixo).
depends=(wlroots0.20 wayland libxkbcommon libinput pixman mesa cairo pango
  # o que os atalhos do Orbit chamam: terminal, brilho, volume (wpctl), captura (lumna-gravity)
  foot brightnessctl wireplumber)
makedepends=(wayland-protocols libdrm)
options=(!strip !debug)

_root="$(realpath "$startdir/../..")"

build() {
  # compila numa cópia: o orbit/ do repositório não ganha Makefile nem binário
  rm -rf "$srcdir/orbit"
  cp -a "$_root/orbit" "$srcdir/orbit"
  cd "$srcdir/orbit"
  cp makefile.txt Makefile
  make PKGS="${ORBIT_PKGS:-wlroots-0.20 wayland-server xkbcommon}"
}

package() {
  cd "$srcdir/orbit"
  install -Dm755 orbit "$pkgdir/usr/bin/orbit"
  install -Dm755 orbit-msg "$pkgdir/usr/bin/orbit-msg"
  install -Dm644 orbit.ini "$pkgdir/usr/share/doc/lumna-orbit/orbit.ini"
  install -Dm644 leiame.txt "$pkgdir/usr/share/doc/lumna-orbit/leiame.txt"
}
