# Gravity: o desktop do LUMNA OS em C (biblioteca de interface + as peças: topbar, dock, início, avisos,
# bloqueio, login, Painel de controle, Emma, Mídia, captura, Connect...). Compilado a partir de gravity/.
pkgname=lumna-gravity
pkgver=0.0.1
pkgrel=1
pkgdesc="O desktop do LUMNA OS em Gravity: topbar, dock, início, avisos, bloqueio, Painel, Emma, Mídia, Connect"
arch=(x86_64 aarch64)
url="https://github.com/dekilled/LUMNA_OS"
license=(GPL-3.0-or-later)
depends=(
  # bibliotecas
  wayland libxkbcommon cairo pango glib2 gdk-pixbuf2 libpulse libsoup3 dbus libvterm sqlite
  # a fonte do terminal (Pulse Terminal)
  ttf-jetbrains-mono ttf-dejavu
  # o que as peças chamam: teclado virtual do controle (wtype), área de transferência, captura e gravação
  wtype wl-clipboard grim wf-recorder
  # som, energia, discos, rede, Bluetooth, bateria e senha de administrador (pkexec)
  wireplumber pipewire-pulse power-profiles-daemon udisks2 networkmanager bluez upower polkit
  # sessão: systemd (localectl, timedatectl), abrir arquivos e links, avisos, rotas, discos
  systemd xdg-utils libnotify iproute2 util-linux ffmpeg libarchive git mpv
  # a Mídia e os links abrem no Firefox; o foot fica de reserva (a sessão de emergência com o Hyprland o usa)
  firefox foot
  # o que o instalador de apps do Painel e a Loja usam (pacman, checkupdates, a busca no AUR)
  pacman-contrib curl)
optdepends=('steam: jogos da Steam na biblioteca do Gaming' 'lutris: jogos do Lutris' 'heroic-games-launcher-bin: Epic e GOG (AUR)' 'gamemode: gamemoderun nas opções de jogo' 'mangohud: o FPS por cima dos jogos (Gaming > Configurações)' 'gogdl: instalar jogos da GOG pela Loja do Gaming (AUR)' 'legendary: instalar jogos da Epic pela Loja do Gaming (AUR)' 'yt-dlp: o trailer dos jogos da GOG' 'paru: instalar do AUR pela Loja' 'yay: instalar do AUR pela Loja (alternativa ao paru)' 'rclone: a nuvem do pré-setup (Google Drive, OneDrive, Dropbox numa pasta)')
makedepends=(wayland-protocols zip)
options=(!strip !debug)

_root="$(realpath "$startdir/../..")"
# nome do binário no repositório -> /usr/bin/lumna-<nome>
_apps=(mixer galeria wifi painel apps papel barra rede transferencia dock lancador avisos bloqueio entrada ocioso inicio
  energia luz modos connect midia emma emma-chat emma-app perfil captura polkit polkit-janela instalador pulse teclado atlas discos musica loja widgets setup jogos gamepad portal processos signals)

build() {
  cd "$_root/gravity"
  make -j"$(nproc)" "${_apps[@]}" processos-ajudante
  make extensao
}

package() {
  cd "$_root/gravity"
  local a
  for a in "${_apps[@]}"; do
    # o app "musica" instala como lumna-music (o nome do .desktop, do app_id e da janela)
    install -Dm755 "$a" "$pkgdir/usr/bin/lumna-${a/#musica/music}"
  done
  # o ajudante com privilégio do gerenciador de processos (pkexec: encerrar e prioridade em processos do sistema; a senha vale por uma sessão)
  install -Dm755 processos-ajudante "$pkgdir/usr/lib/lumna/lumna-processos-ajudante"
  # o que as peças leem de /usr/share/lumna: a arte da Emma e a extensão do Firefox da Mídia
  install -d "$pkgdir/usr/share/lumna/emma"
  cp -a assets/emma/. "$pkgdir/usr/share/lumna/emma/"
  # a integração do Pulse Terminal com o bash (as marcas do prompt e o aviso de cada comando)
  install -Dm644 pulse-shell/integracao.bash "$pkgdir/usr/share/lumna/pulse/integracao.bash"
  install -Dm644 extensao-firefox/lumna-midia.xpi "$pkgdir/usr/share/lumna/midia/lumna-midia.xpi"
  # os atalhos dos apps e os ícones deles (tema hicolor)
  cd "$_root/packages/lumna-gravity"
  install -Dm644 -t "$pkgdir/usr/share/applications" desktop/*.desktop
  install -Dm644 -t "$pkgdir/usr/share/icons/hicolor/scalable/apps" icones/*.svg
  install -Dm644 os.lumna.processos.policy "$pkgdir/usr/share/polkit-1/actions/os.lumna.processos.policy"
  install -Dm644 lumna-portals.conf "$pkgdir/usr/share/xdg-desktop-portal/lumna-portals.conf"
  # "Mostrar na pasta" (Firefox, Chromium, Steam...) abre o Atlas: o lumna-portal responde ao org.freedesktop.FileManager1.
  # Fora de /usr/share/dbus-1/services de propósito: o nautilus, o thunar e o dolphin entregam esse mesmo arquivo e o pacman recusaria a instalação;
  # a sessão copia este para o diretório do usuário, que vale mais que o do sistema.
  install -Dm644 dbus/org.freedesktop.FileManager1.service "$pkgdir/usr/share/lumna/dbus-1/services/org.freedesktop.FileManager1.service"
  # o seletor de arquivos do xdg-desktop-portal (abrir, enviar, salvar, escolher pasta) é o Atlas: o backend "lumna" do lumna-portal
  install -Dm644 dbus/org.freedesktop.impl.portal.desktop.lumna.service "$pkgdir/usr/share/dbus-1/services/org.freedesktop.impl.portal.desktop.lumna.service"
  install -Dm644 portals/lumna.portal "$pkgdir/usr/share/xdg-desktop-portal/portals/lumna.portal"
}
