# Sessão live: o usuário lumna ganha a senha "lumna". Se a sessão gráfica cair, dá para entrar
# de novo pela tela de login de texto do greetd (sem senha conhecida, ninguém entraria).
[Unit]
Description=Senha do usuário do LUMNA live
Before=greetd.service
After=systemd-sysusers.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'echo lumna:lumna | chpasswd'

[Install]
WantedBy=multi-user.target
