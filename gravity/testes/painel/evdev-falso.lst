! model
  pc105           Generic 105-key PC

! layout
  us              English (US)
  br              Portuguese (Brazil)
  de              German

! variant
  intl            us: English (US, intl., with dead keys)
  nodeadkeys      br: Portuguese (Brazil, no dead keys)
  nativo          br: Portuguese (Brazil, Nativo)
  nodeadkeys      de: German (no dead keys)

