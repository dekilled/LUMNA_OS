#!/bin/sh
# Mantém o lumna-shell de pé: se ele cair, volta sozinho em seguida. Se cair de novo logo depois,
# espera um pouco mais a cada vez (até 30 s), para não ficar num laço de quedas.
pause=1
while :; do
  started=$(date +%s)
  lumna-shell "$@"
  status=$?
  [ "$status" -eq 0 ] && exit 0
  if [ $(($(date +%s) - started)) -lt 10 ]; then
    pause=$((pause * 2))
    [ "$pause" -gt 30 ] && pause=30
  else
    pause=1
  fi
  echo "lumna-shell caiu (código $status); reabrindo em ${pause}s" >&2
  sleep "$pause"
done
