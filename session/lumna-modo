#!/bin/sh
# lumna-modo: o modo do desktop (Desktop, Gaming ou Mídia), pelo Orbit. Cada saída tem o seu; o Super+Tab
# e o seletor da topbar usam o mesmo caminho.
#   lumna-modo                  o modo da saída em foco
#   lumna-modo seguinte|anterior
#   lumna-modo desktop|gaming|midia
case "$1" in
"") orbit-msg modo | sed -n 's/.*"ponteiro":true.*/&/p' | head -n1 | grep -o '"modo":"[a-z]*"' | cut -d'"' -f4 | head -n1 ;;
seguinte | anterior | desktop | gaming | midia) exec orbit-msg modo "$1" >/dev/null ;;
*) echo "uso: lumna-modo [seguinte|anterior|desktop|gaming|midia]" >&2; exit 1 ;;
esac
