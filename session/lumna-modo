#!/bin/sh
# lumna-modo: o modo do desktop (Desktop, Gaming ou Mídia), em ~/.config/lumna/modo. Quem vigia o
# arquivo segue o modo (o papel de parede de cada modo, por enquanto). O Super+Tab chama
# "lumna-modo seguinte".
#   lumna-modo                  diz o modo de agora
#   lumna-modo seguinte         passa ao próximo (Desktop → Gaming → Mídia → Desktop)
#   lumna-modo desktop|gaming|midia
PASTA="${XDG_CONFIG_HOME:-$HOME/.config}/lumna"
ARQ="$PASTA/modo"
agora=$(cat "$ARQ" 2>/dev/null)
[ -n "$agora" ] || agora=desktop
case "$1" in
"") echo "$agora"; exit 0 ;;
seguinte)
	case "$agora" in
	desktop) novo=gaming ;;
	gaming) novo=midia ;;
	*) novo=desktop ;;
	esac ;;
desktop | gaming | midia) novo=$1 ;;
*) echo "uso: lumna-modo [seguinte|desktop|gaming|midia]" >&2; exit 1 ;;
esac
mkdir -p "$PASTA"
printf '%s\n' "$novo" > "$ARQ.tmp" && mv "$ARQ.tmp" "$ARQ"
case "$novo" in
desktop) nome=Desktop ;;
gaming) nome=Gaming ;;
midia) nome=Mídia ;;
esac
notify-send -a LUMNA -h string:x-canonical-private-synchronous:lumna-modo "Modo $nome" 2>/dev/null
exit 0
