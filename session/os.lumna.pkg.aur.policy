<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>LUMNA OS</vendor>
  <vendor_url>https://github.com/dekilled/LUMNA_OS</vendor_url>
  <action id="os.lumna.pkg.aur">
    <description>Install a package built from the AUR</description>
    <description xml:lang="pt_BR">Instalar um pacote compilado do AUR</description>
    <message>Installing a package built from the AUR needs your password.</message>
    <message xml:lang="pt_BR">Instalar um pacote compilado do AUR precisa da sua senha.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <!-- Toda vez: um pacote do AUR é código de fora rodando como root (a senha lembrada da Loja não vale aqui). -->
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/lumna/lumna-pkg-aur</annotate>
  </action>
</policyconfig>
