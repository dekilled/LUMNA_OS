#!/bin/sh
# A tela de login do desktop novo: o greetd corre isto como o usuário "greeter". Um Orbit só para
# a tela de entrada; com a senha certa ela sai, o Orbit (-S) fecha com ela e o greetd abre a sessão.
# No /etc/greetd/config.toml:  [default_session]  command = "lumna-entrada-greeter"  user = "greeter"
export XDG_SESSION_TYPE=wayland
export ORBIT_BORDA=0
[ -f /usr/lib/lumna/gpu-env ] && . /usr/lib/lumna/gpu-env
# o que o Orbit escreve (os avisos da libseat, do wlroots) não vai para o terminal: ficaria como letrinhas no canto da tela na troca do login para a sessão.
# O journal guarda (journalctl -t lumna-greeter); sem o systemd-cat, vai para o nada.
if command -v systemd-cat >/dev/null 2>&1; then
	exec systemd-cat -t lumna-greeter orbit -S lumna-entrada
fi
exec orbit -S lumna-entrada 2>/dev/null
