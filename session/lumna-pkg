#!/bin/bash
# Operações de pacotes da Loja do LUMNA. Roda como root pelo pkexec (política os.lumna.pkg):
#   lumna-pkg install PACOTE...   instala dos repositórios (sincroniza antes, se nunca sincronizou)
#   lumna-pkg remove PACOTE...    remove com as dependências que ficarem sobrando
#   lumna-pkg upgrade             atualiza o sistema inteiro (antes, tira um snapshot Btrfs, para voltar se der errado)
#   lumna-pkg upgrade-lumna       atualiza SÓ o que vem do repositório [lumna] (os bancos do Arch ficam como estão: nada de atualização parcial do Arch); para e avisa se
#                                 isso exigir mexer em pacotes do Arch (aí é a atualização completa)
#   lumna-pkg upgrade-pacotes PACOTE...   atualiza SÓ os pacotes escolhidos (a lista "Escolher pacotes" do Painel): recusa o sistema base e qualquer escolha que puxe a
#                                 atualização de OUTROS pacotes já instalados ou que o pacman recuse; usa um banco privado e novo, sem tocar no banco do sistema
#   lumna-pkg agendar LIGADO ESCOPO HH:MM DIAS   liga/desliga a atualização no horário marcado (ligado|desligado, tudo|lumna, 03:00, todos|seg,qua,sex)
#   lumna-pkg agendado            o que o timer chama no horário (não é para usar na mão): atualiza conforme /etc/lumna/atualizar.conf e anota o resultado
#   lumna-pkg snapshots           lista os snapshots de antes das atualizações (os 5 últimos ficam)
#   lumna-pkg voltar [SNAPSHOT]   volta o sistema ao estado de um snapshot (o último, se não disser): reinicie depois
#   lumna-pkg multilib on|off     liga/desliga o repositório de 32 bits (Steam, Wine)
#   lumna-pkg pacman ARGS...      o pacman do makepkg (AUR): só pelo lumna-pkg-aur, que pede a senha toda vez
set -euo pipefail
export LC_ALL=C

synced() { compgen -G "/var/lib/pacman/sync/*.db" >/dev/null; }

# Os snapshots de antes de cada atualização vivem em /.snapshots (o subvolume @snapshots que o instalador cria). Para os testes:
# LUMNA_SNAPDIR troca a pasta e dispensa o Btrfs de verdade.
SNAPDIR="${LUMNA_SNAPDIR:-/.snapshots}"
MANTER=5

snapshot_antes() {
  [ -d "$SNAPDIR" ] || return 0
  if [ -z "${LUMNA_SNAPDIR:-}" ] && [ "$(findmnt -no FSTYPE / 2>/dev/null)" != btrfs ]; then return 0; fi
  local nome="antes-$(date +%Y%m%d-%H%M%S)"
  chmod 755 "$SNAPDIR" 2>/dev/null || true # só os nomes aparecem (o Painel conta); o conteúdo segue com as permissões de cada arquivo
  if btrfs subvolume snapshot -r / "$SNAPDIR/$nome" >/dev/null 2>&1; then
    echo "Snapshot $nome guardado (para voltar atrás: lumna-pkg voltar)"
  else
    echo "Aviso: não consegui tirar o snapshot antes de atualizar; a atualização segue sem ele." >&2
  fi
  # guarda só os últimos
  ls -1d "$SNAPDIR"/antes-* 2>/dev/null | sort | head -n "-$MANTER" | while read -r velho; do
    btrfs subvolume delete "$velho" >/dev/null 2>&1 || true
  done
}

voltar() {
  local alvo="${1:-}"
  if [ -z "$alvo" ]; then alvo="$(ls -1d "$SNAPDIR"/antes-* 2>/dev/null | sort | tail -1)"; fi
  alvo="${alvo##*/}"
  # só um snapshot que este script tirou: um caminho qualquer (um subvolume que o usuário criou na pasta dele) viraria o sistema do próximo boot
  case "$alvo" in antes-[0-9]*) ;; *) echo "não achei esse snapshot (veja: lumna-pkg snapshots)" >&2; exit 1 ;; esac
  case "$alvo" in *[!A-Za-z0-9-]*) echo "nome de snapshot estranho: $alvo" >&2; exit 1 ;; esac
  alvo="$SNAPDIR/$alvo"
  [ -d "$alvo" ] || { echo "não achei esse snapshot (veja: lumna-pkg snapshots)" >&2; exit 1; }
  local dev top novo
  dev="$(findmnt -no SOURCE / | sed 's/\[.*//')"
  top="$(mktemp -d)"
  mount -o subvolid=5 "$dev" "$top"
  novo="@-quebrado-$(date +%Y%m%d-%H%M%S)"
  # o @ de agora vira @-quebrado (o sistema que está rodando continua nele até reiniciar) e o snapshot vira o novo @
  mv "$top/@" "$top/$novo"
  btrfs subvolume snapshot "$alvo" "$top/@"
  umount "$top"
  rmdir "$top" 2>/dev/null || true
  echo "Pronto: o sistema volta a ${alvo##*/} no próximo boot. Reinicie. O estado de antes ficou em $novo (apague com 'btrfs subvolume delete' quando não precisar)."
}

# O que o makepkg pede ao pacman (instalar o pacote que compilou, as dependências, marcar como dependência, remover as de compilação) e nada mais:
# as opções que mudam onde o pacman lê ou escreve (outra configuração, outra raiz, outro banco, ganchos, o arquivo de log) fariam do
# "lumna-pkg pacman" um root qualquer, inclusive sem senha nos minutos em que o pkexec lembra dela.
pacman_confere() {
  local op="" a
  for a in "$@"; do
    case "$a" in
      --config|--config=*|--root|--root=*|--dbpath|--dbpath=*|--hookdir|--hookdir=*|--gpgdir|--gpgdir=*|--cachedir|--cachedir=*|--sysroot|--sysroot=*|--logfile|--logfile=*|--overwrite|--overwrite=*)
        echo "lumna-pkg: a opção $a não é permitida" >&2; exit 2 ;;
      --*) ;;
      -*)
        case "$a" in *r*|*b*) echo "lumna-pkg: a opção $a não é permitida (-r e -b mudam a raiz e o banco)" >&2; exit 2 ;; esac
        [ -z "$op" ] && op="${a:1:1}" ;;
    esac
  done
  case "$op" in
    U|S|D|R|T|Q) ;;
    *) echo "lumna-pkg: operação do pacman não permitida: -$op" >&2; exit 2 ;;
  esac
}

# ---- só o LUMNA ----
# Os bancos do pacman (/var/lib/pacman/sync) guardam o retrato do Arch na última atualização completa. "Atualizar só o LUMNA" baixa APENAS o lumna.db novo: o pacman então
# só enxerga versões novas dos pacotes do [lumna] e confere as dependências contra o resto do sistema como ele está. O que exigir um Arch mais novo não é instalado (o
# Arch não suporta atualização parcial): sai com código 3 e a mensagem diz que é preciso atualizar tudo.
DBPATH="${LUMNA_DBPATH:-$(pacman-conf DBPath 2>/dev/null || echo /var/lib/pacman/)}"
ETC="${LUMNA_ETC:-/etc}"
VARLIB="${LUMNA_VARLIB:-/var/lib/lumna}"
LOGAT="${LUMNA_LOG_ATUALIZAR:-/var/log/lumna-atualizar.log}"

sync_lumna() {
  local srv dir tmp
  [ -e "${DBPATH}db.lck" ] && { echo "o pacman está em uso (${DBPATH}db.lck); tente de novo quando ele terminar." >&2; return 1; }
  srv="$(pacman-conf --repo=lumna Server 2>/dev/null | head -n1 || true)"
  [ -n "$srv" ] || { echo "o repositório [lumna] não está configurado neste sistema." >&2; return 1; }
  srv="${srv//\$repo/lumna}"; srv="${srv//\$arch/$(uname -m)}"
  dir="${DBPATH}sync"
  mkdir -p "$dir"
  tmp="$(mktemp "$dir/.lumna.db.XXXXXX")"
  if ! curl -fsSL --retry 2 --max-time 90 -o "$tmp" "$srv/lumna.db" || ! bsdtar -tf "$tmp" >/dev/null 2>&1; then
    rm -f "$tmp"
    echo "não consegui baixar a lista de pacotes do repositório LUMNA ($srv)." >&2
    return 1
  fi
  # uma assinatura velha do banco antigo faria o pacman recusar o novo (o [lumna] é "Optional": sem assinatura vale)
  rm -f "$dir/lumna.db.sig"
  curl -fsSL --max-time 30 -o "$dir/lumna.db.sig" "$srv/lumna.db.sig" 2>/dev/null || rm -f "$dir/lumna.db.sig"
  mv -f "$tmp" "$dir/lumna.db"
}

# códigos: 0 atualizou, 10 já estava em dia, 3 precisa da atualização completa, 1 falhou
upgrade_lumna() {
  sync_lumna || return 1
  local pend=() sim fora
  mapfile -t pend < <(comm -12 <(pacman -Qu 2>/dev/null | awk '{print $1}' | sort) <(pacman -Slq lumna 2>/dev/null | sort))
  if [ "${#pend[@]}" -eq 0 ]; then
    echo "O LUMNA já está em dia."
    return 10
  fi
  echo "Atualizações do LUMNA: ${pend[*]}"
  if ! sim="$(pacman -S --needed --print --print-format 'LUMNA-SIM %r %n %v' -- "${pend[@]}" 2>&1)"; then
    echo "Não dá para atualizar só o LUMNA agora: o pacman recusou a conta." >&2
    printf '%s\n' "$sim" >&2
    echo "Isso costuma ser um pacote do LUMNA que pede algo mais novo do Arch: atualize tudo." >&2
    return 3
  fi
  fora="$(printf '%s\n' "$sim" | awk '$1 == "LUMNA-SIM" && $2 != "lumna" {print $3}' | tr '\n' ' ')"
  if [ -n "$fora" ]; then
    echo "Atualizar o LUMNA exigiria atualizar também pacotes do Arch: $fora" >&2
    echo "O Arch não suporta atualização parcial: nada foi instalado. Atualize tudo." >&2
    return 3
  fi
  snapshot_antes
  pacman -S --needed --noconfirm --noprogressbar -- "${pend[@]}" || return 1
  return 0
}

# ---- só os pacotes escolhidos ----
BASE_LISTA="${LUMNA_BASE_LISTA:-/usr/share/lumna/pacotes-base.txt}"
PRIVDB="${LUMNA_PRIVDB:-$VARLIB/pacman-db}"

# o pacote é do sistema base (a lista /usr/share/lumna/pacotes-base.txt, com padrões * e ?)? Esses só se atualizam junto com tudo
eh_base() {
  local l p
  [ -r "$BASE_LISTA" ] || return 1
  while IFS= read -r l; do
    p="${l%%#*}"; p="${p//[[:space:]]/}"
    [ -n "$p" ] && [[ "$1" == $p ]] && return 0
  done < "$BASE_LISTA"
  return 1
}

# códigos: 0 atualizou, 2 pedido inválido, 3 não dá para atualizar só esses (base, puxaria outros, o pacman recusou), 1 falhou
upgrade_pacotes() {
  local sel=("$@") n sim dragged="" novos="" outro marca _ com_atu=() atu
  [ "${#sel[@]}" -gt 0 ] || { echo "uso: lumna-pkg upgrade-pacotes PACOTE..." >&2; return 2; }
  for n in "${sel[@]}"; do
    [[ "$n" =~ ^[a-z0-9@._+-]+$ ]] || { echo "nome de pacote inválido: $n" >&2; return 2; }
    if eh_base "$n"; then
      echo "$n é do sistema base e só se atualiza junto com tudo (Atualizar tudo)." >&2
      return 3
    fi
  done
  [ -e "${DBPATH}db.lck" ] && { echo "o pacman está em uso (${DBPATH}db.lck); tente de novo quando ele terminar." >&2; return 1; }
  # um banco PRIVADO e novo (como o do checkupdates): o banco do sistema, que guarda o retrato do Arch da última atualização completa, não é tocado.
  # O banco dos pacotes instalados (local) é o do sistema, por um link: o que se instala fica registrado de verdade.
  mkdir -p "$PRIVDB/sync"
  ln -sfn "${DBPATH}local" "$PRIVDB/local"
  pacman --dbpath "$PRIVDB" -Sy --noconfirm --noprogressbar >/dev/null || { echo "não consegui sincronizar a lista de pacotes." >&2; return 1; }
  atu=" $(pacman --dbpath "$PRIVDB" -Qu 2>/dev/null | awk '{print $1}' | tr '\n' ' ')"
  for n in "${sel[@]}"; do
    case "$atu" in
      *" $n "*) com_atu+=("$n") ;;
      *) echo "$n já está em dia: ficou de fora." ;;
    esac
  done
  [ "${#com_atu[@]}" -gt 0 ] || { echo "Nada a atualizar entre os escolhidos."; return 0; }
  if ! sim="$(pacman --dbpath "$PRIVDB" -S --needed --print --print-format 'LUMNA-SIM %r %n %v' -- "${com_atu[@]}" 2>&1)"; then
    echo "Não dá para atualizar só esses pacotes: o pacman recusou a conta." >&2
    printf '%s\n' "$sim" >&2
    echo "Nada foi instalado. Atualize tudo, ou escolha outros pacotes." >&2
    return 3
  fi
  while read -r marca _ outro _; do
    [ "$marca" = "LUMNA-SIM" ] || continue
    case " ${com_atu[*]} " in *" $outro "*) continue ;; esac
    if pacman -Q "$outro" >/dev/null 2>&1; then dragged="$dragged $outro"; else novos="$novos $outro"; fi
  done <<< "$sim"
  if [ -n "$dragged" ]; then
    echo "Esta escolha puxaria a atualização de outros pacotes que já estão instalados:$dragged" >&2
    echo "O Arch não suporta atualização parcial: nada foi instalado. Marque esses também, ou atualize tudo." >&2
    return 3
  fi
  [ -n "$novos" ] && echo "Também serão instalados (dependências novas):$novos"
  echo "Atualizando: ${com_atu[*]}"
  snapshot_antes
  pacman --dbpath "$PRIVDB" -S --needed --noconfirm --noprogressbar -- "${com_atu[@]}" || return 1
  return 0
}

# ---- o horário marcado ----
agendar() {
  local modo="${1:-}" escopo="${2:-}" hora="${3:-}" dias="${4:-}" d lista=() nomes
  case "$modo" in ligado|desligado) ;; *) echo "uso: lumna-pkg agendar ligado|desligado tudo|lumna HH:MM todos|seg,ter,..." >&2; exit 2 ;; esac
  case "$escopo" in tudo|lumna) ;; *) echo "escopo inválido: use tudo ou lumna" >&2; exit 2 ;; esac
  [[ "$hora" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]] || { echo "hora inválida: use HH:MM (00:00 a 23:59)" >&2; exit 2; }
  [[ "$dias" =~ ^(todos|(seg|ter|qua|qui|sex|sab|dom)(,(seg|ter|qua|qui|sex|sab|dom))*)$ ]] || { echo "dias inválidos: use todos ou uma lista como seg,qua,sex" >&2; exit 2; }
  nomes="*"
  if [ "$dias" != todos ]; then
    nomes=""
    IFS=, read -ra lista <<< "$dias"
    for d in "${lista[@]}"; do
      case "$d" in seg) d=Mon ;; ter) d=Tue ;; qua) d=Wed ;; qui) d=Thu ;; sex) d=Fri ;; sab) d=Sat ;; dom) d=Sun ;; esac
      nomes="${nomes:+$nomes,}$d"
    done
  fi
  mkdir -p "$ETC/lumna" "$ETC/systemd/system/lumna-atualizar.timer.d"
  printf 'modo=%s\nescopo=%s\nhora=%s\ndias=%s\n' "$modo" "$escopo" "$hora" "$dias" > "$ETC/lumna/atualizar.conf"
  chmod 644 "$ETC/lumna/atualizar.conf"
  # Persistent=true: se o PC estava desligado na hora marcada, roda assim que ligar
  printf '[Timer]\nOnCalendar=\nOnCalendar=%s *-*-* %s:00\nPersistent=true\n' "$([ "$nomes" = '*' ] && echo '' || echo "$nomes")" "$hora" | sed 's/OnCalendar= \*-\*-\*/OnCalendar=*-*-*/' > "$ETC/systemd/system/lumna-atualizar.timer.d/horario.conf"
  if [ -z "${LUMNA_SEM_SYSTEMCTL:-}" ]; then
    systemctl daemon-reload
    if [ "$modo" = ligado ]; then systemctl enable --now lumna-atualizar.timer; else systemctl disable --now lumna-atualizar.timer || true; fi
  fi
  echo "Atualização agendada: $modo ($escopo, $hora, $dias)"
}

# o que o timer chama: faz a atualização do jeito configurado e anota o resultado (o Painel lê o estado). Não instala nada do AUR (precisa de senha e de uma pessoa).
agendado() {
  local escopo rc=0 saida resultado pacotes=""
  escopo="$(sed -n 's/^escopo=//p' "$ETC/lumna/atualizar.conf" 2>/dev/null | head -n1)"
  [ "$escopo" = lumna ] || escopo=tudo
  mkdir -p "$(dirname "$LOGAT")" "$VARLIB"
  if [ -f "$LOGAT" ] && [ "$(wc -c < "$LOGAT")" -gt 524288 ]; then tail -n 2000 "$LOGAT" > "$LOGAT.novo" && mv -f "$LOGAT.novo" "$LOGAT"; fi
  echo "== $(date '+%F %T') atualização agendada (escopo: $escopo) ==" >> "$LOGAT"
  saida="$(mktemp)"
  if [ "$escopo" = lumna ]; then
    upgrade_lumna > "$saida" 2>&1 || rc=$?
  else
    { snapshot_antes; pacman -Syu --noconfirm --noprogressbar; } > "$saida" 2>&1 || rc=$?
  fi
  cat "$saida" >> "$LOGAT"
  case "$rc" in
    0) if grep -q 'there is nothing to do' "$saida"; then resultado=nada; else resultado=ok; fi ;;
    10) resultado=nada ;;
    3) resultado=precisa-completa ;;
    *) resultado=falhou ;;
  esac
  pacotes="$(sed -n 's/^Atualizações do LUMNA: //p' "$saida" | head -n1)"
  printf 'quando=%s\nescopo=%s\nresultado=%s\npacotes=%s\n' "$(date +%s)" "$escopo" "$resultado" "$pacotes" > "$VARLIB/atualizar.estado.novo"
  chmod 644 "$VARLIB/atualizar.estado.novo"
  mv -f "$VARLIB/atualizar.estado.novo" "$VARLIB/atualizar.estado"
  echo "== resultado: $resultado ==" >> "$LOGAT"
  rm -f "$saida"
  [ "$resultado" = falhou ] && return 1
  return 0
}

case "${1:-}" in
  install)
    shift
    synced || pacman -Sy --noconfirm --noprogressbar
    exec pacman -S --needed --noconfirm --noprogressbar -- "$@"
    ;;
  remove)
    shift
    exec pacman -Rns --noconfirm --noprogressbar -- "$@"
    ;;
  upgrade)
    snapshot_antes
    exec pacman -Syu --noconfirm --noprogressbar
    ;;
  upgrade-lumna)
    rc=0; upgrade_lumna || rc=$?
    [ "$rc" = 10 ] && rc=0
    exit "$rc"
    ;;
  upgrade-pacotes)
    shift
    rc=0; upgrade_pacotes "$@" || rc=$?
    exit "$rc"
    ;;
  agendar)
    shift
    agendar "$@"
    ;;
  agendado)
    agendado
    ;;
  snapshots)
    ls -1d "$SNAPDIR"/antes-* 2>/dev/null | sort | sed 's|.*/||'
    ;;
  voltar)
    voltar "${2:-}"
    ;;
  multilib)
    case "${2:-}" in
      on) sed -i '/^#\[multilib\]$/{s/^#//;n;s/^#//}' /etc/pacman.conf ;;
      off) sed -i '/^\[multilib\]$/{s/^/#/;n;s/^/#/}' /etc/pacman.conf ;;
      *) echo "uso: lumna-pkg multilib on|off" >&2; exit 2 ;;
    esac
    exec pacman -Sy --noconfirm --noprogressbar
    ;;
  pacman)
    shift
    # O makepkg chama "$PACMAN_AUTH pacman ARGS": o caminho do pacman vem junto.
    if [ "${1:-}" = /usr/bin/pacman ] || [ "${1:-}" = pacman ]; then shift; fi
    # só pelo lumna-pkg-aur (a ação do polkit que pede a senha toda vez): direto aqui, a senha lembrada da Loja valeria para o AUR.
    # (o pkexec limpa o ambiente de quem chama: só o lumna-pkg-aur, já como root, consegue pôr esta variável)
    [ "${LUMNA_PKG_VIA_AUR:-}" = 1 ] || { echo "lumna-pkg: o pacman do AUR é pelo /usr/lib/lumna/lumna-pkg-aur" >&2; exit 2; }
    pacman_confere "$@"
    exec pacman "$@"
    ;;
  *)
    echo "uso: lumna-pkg install|remove|upgrade|upgrade-lumna|upgrade-pacotes PACOTE...|agendar ...|snapshots|voltar [SNAPSHOT]|multilib on|off|pacman ..." >&2
    exit 2
    ;;
esac
