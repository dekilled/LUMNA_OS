#!/bin/bash
# Operações de pacotes da Loja do LUMNA. Roda como root pelo pkexec (política os.lumna.pkg):
#   lumna-pkg install PACOTE...   instala dos repositórios (sincroniza antes, se nunca sincronizou)
#   lumna-pkg remove PACOTE...    remove com as dependências que ficarem sobrando
#   lumna-pkg upgrade             atualiza o sistema inteiro (antes, tira um snapshot Btrfs, para voltar se der errado)
#   lumna-pkg snapshots           lista os snapshots de antes das atualizações (os 5 últimos ficam)
#   lumna-pkg voltar [SNAPSHOT]   volta o sistema ao estado de um snapshot (o último, se não disser): reinicie depois
#   lumna-pkg multilib on|off     liga/desliga o repositório de 32 bits (Steam, Wine)
#   lumna-pkg pacman ARGS...      o pacman puro, para o makepkg instalar pacotes do AUR
set -euo pipefail
export LC_ALL=C

synced() { compgen -G "/var/lib/pacman/sync/*.db" >/dev/null; }

# Os snapshots de antes de cada atualização vivem em /.snapshots (o subvolume @snapshots que o instalador cria). Para os testes:
# LUMNA_SNAPDIR troca a pasta e dispensa o Btrfs de verdade.
SNAPDIR="${LUMNA_SNAPDIR:-/.snapshots}"
MANTER=5

snapshot_antes() {
  [ -d "$SNAPDIR" ] || return 0
  if [ -z "${LUMNA_SNAPDIR:-}" ] && [ "$(findmnt -no FSTYPE / 2>/dev/null)" != btrfs ]; then return 0; fi
  local nome="antes-$(date +%Y%m%d-%H%M%S)"
  chmod 755 "$SNAPDIR" 2>/dev/null || true # só os nomes aparecem (o Painel conta); o conteúdo segue com as permissões de cada arquivo
  if btrfs subvolume snapshot -r / "$SNAPDIR/$nome" >/dev/null 2>&1; then
    echo "Snapshot $nome guardado (para voltar atrás: lumna-pkg voltar)"
  else
    echo "Aviso: não consegui tirar o snapshot antes de atualizar; a atualização segue sem ele." >&2
  fi
  # guarda só os últimos
  ls -1d "$SNAPDIR"/antes-* 2>/dev/null | sort | head -n "-$MANTER" | while read -r velho; do
    btrfs subvolume delete "$velho" >/dev/null 2>&1 || true
  done
}

voltar() {
  local alvo="${1:-}"
  if [ -z "$alvo" ]; then alvo="$(ls -1d "$SNAPDIR"/antes-* 2>/dev/null | sort | tail -1)"; fi
  alvo="${alvo##*/}"
  # só um snapshot que este script tirou: um caminho qualquer (um subvolume que o usuário criou na pasta dele) viraria o sistema do próximo boot
  case "$alvo" in antes-[0-9]*) ;; *) echo "não achei esse snapshot (veja: lumna-pkg snapshots)" >&2; exit 1 ;; esac
  case "$alvo" in *[!A-Za-z0-9-]*) echo "nome de snapshot estranho: $alvo" >&2; exit 1 ;; esac
  alvo="$SNAPDIR/$alvo"
  [ -d "$alvo" ] || { echo "não achei esse snapshot (veja: lumna-pkg snapshots)" >&2; exit 1; }
  local dev top novo
  dev="$(findmnt -no SOURCE / | sed 's/\[.*//')"
  top="$(mktemp -d)"
  mount -o subvolid=5 "$dev" "$top"
  novo="@-quebrado-$(date +%Y%m%d-%H%M%S)"
  # o @ de agora vira @-quebrado (o sistema que está rodando continua nele até reiniciar) e o snapshot vira o novo @
  mv "$top/@" "$top/$novo"
  btrfs subvolume snapshot "$alvo" "$top/@"
  umount "$top"
  rmdir "$top" 2>/dev/null || true
  echo "Pronto: o sistema volta a ${alvo##*/} no próximo boot. Reinicie. O estado de antes ficou em $novo (apague com 'btrfs subvolume delete' quando não precisar)."
}

# O que o makepkg pede ao pacman (instalar o pacote que compilou, as dependências, marcar como dependência, remover as de compilação) e nada mais:
# as opções que mudam onde o pacman lê ou escreve (outra configuração, outra raiz, outro banco, ganchos, o arquivo de log) fariam do
# "lumna-pkg pacman" um root qualquer, inclusive sem senha nos minutos em que o pkexec lembra dela.
pacman_confere() {
  local op="" a
  for a in "$@"; do
    case "$a" in
      --config|--config=*|--root|--root=*|--dbpath|--dbpath=*|--hookdir|--hookdir=*|--gpgdir|--gpgdir=*|--cachedir|--cachedir=*|--sysroot|--sysroot=*|--logfile|--logfile=*|--overwrite|--overwrite=*)
        echo "lumna-pkg: a opção $a não é permitida" >&2; exit 2 ;;
      --*) ;;
      -*)
        case "$a" in *r*|*b*) echo "lumna-pkg: a opção $a não é permitida (-r e -b mudam a raiz e o banco)" >&2; exit 2 ;; esac
        [ -z "$op" ] && op="${a:1:1}" ;;
    esac
  done
  case "$op" in
    U|S|D|R|T|Q) ;;
    *) echo "lumna-pkg: operação do pacman não permitida: -$op" >&2; exit 2 ;;
  esac
}

case "${1:-}" in
  install)
    shift
    synced || pacman -Sy --noconfirm --noprogressbar
    exec pacman -S --needed --noconfirm --noprogressbar -- "$@"
    ;;
  remove)
    shift
    exec pacman -Rns --noconfirm --noprogressbar -- "$@"
    ;;
  upgrade)
    snapshot_antes
    exec pacman -Syu --noconfirm --noprogressbar
    ;;
  snapshots)
    ls -1d "$SNAPDIR"/antes-* 2>/dev/null | sort | sed 's|.*/||'
    ;;
  voltar)
    voltar "${2:-}"
    ;;
  multilib)
    case "${2:-}" in
      on) sed -i '/^#\[multilib\]$/{s/^#//;n;s/^#//}' /etc/pacman.conf ;;
      off) sed -i '/^\[multilib\]$/{s/^/#/;n;s/^/#/}' /etc/pacman.conf ;;
      *) echo "uso: lumna-pkg multilib on|off" >&2; exit 2 ;;
    esac
    exec pacman -Sy --noconfirm --noprogressbar
    ;;
  pacman)
    shift
    # O makepkg chama "$PACMAN_AUTH pacman ARGS": o caminho do pacman vem junto.
    if [ "${1:-}" = /usr/bin/pacman ] || [ "${1:-}" = pacman ]; then shift; fi
    pacman_confere "$@"
    exec pacman "$@"
    ;;
  *)
    echo "uso: lumna-pkg install|remove|upgrade|snapshots|voltar [SNAPSHOT]|multilib on|off|pacman ..." >&2
    exit 2
    ;;
esac
