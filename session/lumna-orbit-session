#!/bin/sh
# A sessão LUMNA · Orbit: o Orbit com as peças do desktop novo (Gravity). O greetd corre isto como
# a pessoa, depois do login.
export XDG_CURRENT_DESKTOP=LUMNA
export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=lumna
export ORBIT_BORDA=0
export ORBIT_TERMINAL=lumna-pulse
[ -f /usr/lib/lumna/gpu-env ] && . /usr/lib/lumna/gpu-env
# "Mostrar na pasta" dos downloads (org.freedesktop.FileManager1) é do Atlas: o serviço do usuário vale mais que o de um Thunar que sobrou no sistema
_fm1="${XDG_DATA_HOME:-$HOME/.local/share}/dbus-1/services/org.freedesktop.FileManager1.service"
if [ -f /usr/share/lumna/dbus-1/services/org.freedesktop.FileManager1.service ] && ! cmp -s /usr/share/lumna/dbus-1/services/org.freedesktop.FileManager1.service "$_fm1" 2>/dev/null; then
	mkdir -p "$(dirname "$_fm1")" && cp /usr/share/lumna/dbus-1/services/org.freedesktop.FileManager1.service "$_fm1"
fi
# A abertura (a animação depois do login): se está ligada e instalada, o Orbit nasce coberto de preto (ORBIT_CORTINA) e o desktop só aparece por baixo dela.
# Sem isso o desktop se mostrava por meio segundo antes de a animação aparecer.
_ini="${XDG_CONFIG_HOME:-$HOME/.config}/lumna/animacoes.ini"
if [ -f /usr/share/lumna/abertura/abertura.mp4 ] && ! grep -Eq '^abertura[[:space:]]*=[[:space:]]*(nao|não|0)' "$_ini" 2>/dev/null; then
	export ORBIT_CORTINA=1
fi
# Os navegadores sem barra de título do LUMNA: os Chromium (Chrome, Brave, Edge...) ligam "Usar a barra de título e bordas do sistema" (a do Orbit) e o Firefox, que no Wayland não
# fala o xdg-decoration, roda em X11 (e o lumna-navegadores-barra liga a "Barra de título" dele): em X11 o Orbit dá a barra a toda janela que pede. Só onde a pessoa nunca escolheu e com
# o navegador fechado. Desligar: ~/.config/lumna/navegadores.ini com "barra_do_sistema = nao".
mkdir -p "$HOME/.local/state/lumna"
lumna-navegadores-barra >>"$HOME/.local/state/lumna/orbit.log" 2>&1 || true
if ! grep -Eiq '^[[:space:]]*barra_do_sistema[[:space:]]*=[[:space:]]*(nao|não|0|false)' "${XDG_CONFIG_HOME:-$HOME/.config}/lumna/navegadores.ini" 2>/dev/null; then
	export MOZ_ENABLE_WAYLAND=0
fi
# O que o Orbit e as peças escrevem (os avisos da libseat, do wlroots) ia para o terminal e aparecia como letrinhas no canto da tela entre o login e o desktop:
# vai para um arquivo (o do login anterior fica em orbit.log.1).
mkdir -p "$HOME/.local/state/lumna"
[ -f "$HOME/.local/state/lumna/orbit.log" ] && mv -f "$HOME/.local/state/lumna/orbit.log" "$HOME/.local/state/lumna/orbit.log.1"
# Os portais (escolher arquivo, compartilhar tela) são ativados pelo D-Bus: precisam saber qual é a tela e o desktop.
# O Orbit só cria o WAYLAND_DISPLAY depois de subir, então o -s empurra o ambiente para o D-Bus antes das peças.
exec dbus-run-session -- orbit -s 'dbus-update-activation-environment WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_SESSION_DESKTOP
	lumna-abertura &
	lumna-papel & lumna-desktop & lumna-barra & lumna-dock & lumna-avisos & lumna-widgets & lumna-ocioso & lumna-inicio & lumna-polkit & lumna-luz & lumna-teclado & lumna-discos & lumna-connect &
	{ mkdir -p ~/.local/state/lumna; lumna-emma 2>>~/.local/state/lumna/emma.log; } &
	lumna-midia servico &
	lumna-processos servico &
	lumna-jogos vigia & lumna-gamepad &
	{ sleep 4; lumna-setup --login; } &' 2>>"$HOME/.local/state/lumna/orbit.log"
