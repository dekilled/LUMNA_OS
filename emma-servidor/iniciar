#!/bin/bash
# O servidor da Emma (o backend Python que veio do NewHarnessV2, ver ORIGEM), ligado pelo próprio LUMNA: o serviço lumna-emma chama
# este script quando o servidor não está no ar. Sem login: o servidor deixa um token único em ~/.config/lumna/emma/chave e o LUMNA entra com ele.
# Na primeira vez cria o ambiente Python (precisa de internet só nessa vez) e os segredos; nada disso aparece para a pessoa.
set -euo pipefail
aqui="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
conf="${XDG_CONFIG_HOME:-$HOME/.config}/lumna/emma"
data="${XDG_DATA_HOME:-$HOME/.local/share}/lumna/emma-servidor"
env="$conf/servidor.env"
mkdir -p "$conf" "$data/workspace"
chmod 700 "$conf" "$data"

py=python3
command -v "$py" >/dev/null || { echo "emma-servidor: falta o python3" >&2; exit 1; }
venv="$data/venv"
if [ ! -x "$venv/bin/uvicorn" ] || [ "$aqui/backend/requirements.txt" -nt "$venv/.pronto" ]; then
  echo "emma-servidor: preparando o ambiente Python (primeira vez)..." >&2
  "$py" -m venv "$venv"
  "$venv/bin/pip" install --quiet --disable-pip-version-check -r "$aqui/backend/requirements.txt"
  touch "$venv/.pronto"
fi

if [ ! -s "$env" ]; then
  rand() { "$py" -c "import secrets; print(secrets.token_$1)"; }
  umask 077
  # a conta interna do servidor: nunca é usada para entrar (o LUMNA usa o token); só existe porque o servidor exige uma
  cat > "$env" <<CONF
# Gerado pelo LUMNA na primeira vez. Não é usado para entrar: o LUMNA usa o token em $conf/chave.
JWT_SECRET=$(rand 'hex(32)')
SECRETS_KEY=$(rand 'hex(32)')
ADMIN_EMAIL=$USER@lumna.local
ADMIN_PASSWORD=$(rand 'urlsafe(24)')
CONF
fi
set -a
. "$env"
set +a
export WORKSPACE_ROOT="$data/workspace" SQLITE_PATH="$data/emma.db" CORS_ORIGINS="" \
  ALLOW_PRIVATE_URLS="${ALLOW_PRIVATE_URLS:-true}" LUMNA_HARNESS_DIR="$aqui" LUMNA_KEY_FILE="$conf/chave" PYTHONDONTWRITEBYTECODE=1
cd "$aqui/backend"
exec "$venv/bin/uvicorn" server:app --host 127.0.0.1 --port "${EMMA_PORT:-8001}" --no-access-log
