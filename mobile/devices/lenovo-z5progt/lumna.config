# Extras do LUMNA por cima da config do LineageOS (kernel 4.14 downstream)
# Necessário pro nosso initramfs
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# Containers, Flatpak (bubblewrap) e Waydroid
CONFIG_SYSVIPC=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
# Init de Linux normal
CONFIG_FHANDLE=y
CONFIG_AUTOFS4_FS=y
