{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "Janelas de Configurações, Loja e Arquivos: arrastar, minimizar, maximizar e fechar pela barra própria",
  "windows": ["settings", "store", "files-*", "installer", "phone", "remote", "emma-app"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-set-title"
  ]
}
